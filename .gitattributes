# Release manifests hash source bytes: preserve them across checkout platforms.
apps/veranode/** -text

# Immutable artifact, builder provenance and legacy fixture bytes must not be normalized.
dist/veranode/** -text
bin/build-veranode-release.cjs -text
experimental/veranode-administration/** -text
test/veranode/fixtures/** -text
# Preserving-upgrade artifacts hash exact bytes, as do first-install releases.
maintenance/veranode/** -text
bin/build-veranode-upgrade.cjs -text
dist/veranode-upgrade/** -text

# Zero initialization hashes committed code and immutable assets.
initialization/zero/** -text
bin/build-veranode-zero.cjs -text
dist/veranode-zero/** -text

bin/veranode-dedicated-target.cjs -text
bin/veranode-runtime-selection.cjs -text
releases/veranode-runtime.json -text
